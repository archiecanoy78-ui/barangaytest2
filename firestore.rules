rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active' &&
        (!get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().contains('isArchived') ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isArchived == false);
    }

    function isAdmin() {
      return isActiveUser() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff');
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == userId ||
        (resource.data.role in ['admin', 'staff'] && resource.data.status == 'active' &&
         (!resource.data.keys().contains('isArchived') || resource.data.isArchived == false))
      );
      allow create, update: if isAuthenticated() && (
        isAdmin() || request.auth.uid == userId
      );
      allow delete: if isAdmin();

      // Notifications Subcollection Rules
      match /notifications/{notificationId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Announcements Rules
    match /announcements/{announcementId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.status == 'published' ||
        resource.data.status == 'Active'
      );
      allow create, update, delete: if isAdmin();
    }

    // Conversations & Real-Time Messaging Rules
    match /conversations/{conversationId} {
      allow read: if isActiveUser() &&
        (isAdmin() || conversationId == request.auth.uid || resource.data.residentId == request.auth.uid);
      allow create, update: if isActiveUser() &&
        (isAdmin() || conversationId == request.auth.uid || request.resource.data.residentId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isActiveUser() &&
          (isAdmin() || conversationId == request.auth.uid);
        allow create: if isActiveUser() &&
          (isAdmin() || conversationId == request.auth.uid) &&
          request.resource.data.text.size() <= 200 &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isActiveUser() &&
          (isAdmin() || conversationId == request.auth.uid);
      }
    }

    function isFinishedReport(data) {
      return data.status == 'resolved' || data.status == 'rejected';
    }

    // Reports & Incidents Rules
    match /reports/{reportId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update: if isActiveUser() && (
        !isFinishedReport(resource.data) ||
        (isAdmin() && request.resource.data.status == 'pending')
      );
      allow delete: if isAdmin();
    }

    // Settings Rules
    match /settings/{settingId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Verification Logs Rules
    match /verification_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isActiveUser();
    }

    // Activity Logs Rules
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isActiveUser();
    }
  }
}
